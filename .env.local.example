# Salin file ini:
#   - Pengembangan lokal : cp .env.local.example .env.local
#   - Docker Compose     : cp .env.local.example .env   (Compose hanya membaca .env)
# Jangan pernah commit file .env / .env.local.

# ===== Database PostgreSQL (wajib) =====
# Gunakan kata sandi tanpa simbol URL (@ : / ? #) agar DATABASE_URL tetap valid.
# Di Docker Compose, DATABASE_URL otomatis diarahkan ke service "db".
DATABASE_URL=postgres://naravia:ganti_kata_sandi_ini@localhost:5432/naravia
POSTGRES_USER=naravia
POSTGRES_PASSWORD=ganti_kata_sandi_ini
POSTGRES_DB=naravia

# ===== Akun Admin Awal (opsional) =====
# Jika diisi, akun ini dibuat (atau dipromosikan menjadi admin) saat server pertama kali terhubung ke database.
# Tanpa ini, akun pertama yang mendaftar di /register otomatis menjadi admin.
# Kosongkan ADMIN_PASSWORD lagi setelah akun admin berhasil dibuat.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ===== Akses & Kuota =====
# open = siapa pun bisa daftar, closed = akun hanya dibuat admin (bisa diubah di Panel Admin)
REGISTRATION_MODE=open
# Kuota token harian bawaan per pengguna (0 = tanpa batas). Admin tidak dibatasi.
DEFAULT_DAILY_TOKEN_BUDGET=200000
# Zona waktu batas reset kuota harian
APP_TIMEZONE=Asia/Jakarta
# Saat NODE_ENV=production, cookie sesi hanya dikirim lewat HTTPS.
# Isi false HANYA jika server produksi diakses lewat HTTP biasa di jaringan lokal.
COOKIE_SECURE=
# Kunci rahasia acak (min. 32 karakter) untuk mengenkripsi API key di database (AES-256-GCM).
# Opsional untuk lokal, sangat disarankan di produksi.
SETTINGS_ENCRYPTION_KEY=

# ===== Provider LLM Awal (opsional) =====
# Hanya dipakai sebagai nilai awal saat database baru dibuat. Setelah itu diatur admin di Panel Admin.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it

# Opsional: API pencarian web untuk riset karakter (Tavily atau Brave Search)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
