# Konfigurasi Universal LLM Provider Naravia
# Mendukung segala jenis provider: OpenRouter, Groq, DeepSeek, OpenAI, Chutes, Together, Ollama, maupun Google AI Studio
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it

# Opsional: API Pencarian Web untuk Riset Karakter (Brave Search atau Tavily)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Opsional: Kunci Akses Server jika di-deploy ke VM / Tunnel Publik
NARAVIA_ACCESS_KEY=
